# CafeMaster Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Port (optional, default: 3000)
PORT=3000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection URI
# For local development with MongoDB installed locally:
# MONGODB_URI=mongodb://127.0.0.1:27017/cafemaster

# For MongoDB Atlas (recommended for production and deployment):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/cafemaster?retryWrites=true&w=majority
#
# Example:
# MONGODB_URI=mongodb+srv://cafemaster:yourpassword@cluster0.mongodb.net/cafemaster?retryWrites=true&w=majority
#
# To get your MongoDB Atlas connection string:
# 1. Go to https://www.mongodb.com/atlas
# 2. Navigate to your cluster
# 3. Click "Connect" > "Connect your application"
# 4. Select Node.js and copy the connection string
# 5. Replace <password> with your actual database password
